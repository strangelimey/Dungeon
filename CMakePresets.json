{
	"version": 6,
	"configurePresets": [
		{
			"name": "debug",
			"displayName": "Ninja Debug",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/debug",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_C_COMPILER": "cl",
				"CMAKE_CXX_COMPILER": "cl"
			}
		},
		{
			"name": "debug-profile",
			"displayName": "Ninja Debug + profiler",
			"inherits": "debug",
			"binaryDir": "${sourceDir}/build/debug-profile",
			"cacheVariables": {
				"DN_PROFILE": "ON"
			}
		},
		{
			"name": "release",
			"displayName": "Ninja Release",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/release",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"CMAKE_C_COMPILER": "cl",
				"CMAKE_CXX_COMPILER": "cl"
			}
		},
		{
			"name": "release-profile",
			"displayName": "Ninja Release + profiler",
			"inherits": "release",
			"binaryDir": "${sourceDir}/build/release-profile",
			"cacheVariables": {
				"DN_PROFILE": "ON"
			}
		},
		{
			"name": "vs",
			"displayName": "Visual Studio solution",
			"generator": "Visual Studio 18 2026",
			"architecture": "x64",
			"binaryDir": "${sourceDir}/build/vs"
		}
	],
	"buildPresets": [
		{ "name": "debug", "configurePreset": "debug" },
		{ "name": "debug-profile", "configurePreset": "debug-profile" },
		{ "name": "release", "configurePreset": "release" },
		{ "name": "release-profile", "configurePreset": "release-profile" },
		{ "name": "vs", "configurePreset": "vs", "configuration": "Debug" }
	]
}
