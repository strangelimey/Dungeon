; Spells: symbol-sequence recipes -> effect + element + power/mana/speed/range.
;
; `on_hit` is the PAYLOAD the cast's carrier delivers, authored exactly as a
; weapon's is: "<effect id> <magnitude> <seconds> [chance]", comma-separated.
; It lands twice over — on the body a bolt strikes, and on everything in the
; cell a bolt BURSTS in when it stops without striking anything (a wall, or the
; end of its reach). The spell's school lends the flavour, so one authored
; `burn` is fire from a firebolt and frost from a waterbolt.

; --- tier 1: a school rune alone is a small thing IN THE HAND (spell-updates).
; Not weapons: power is only what a threshold below is measured against.
[flame]
name = spell.flame
symbols = fire
power = 8
mana = 2
; an unlit brazier ahead catches only at this power or more
brazier_power = 14

[rock]
name = spell.rock
symbols = earth
power = 8
mana = 2
; the item conjured into the hand (or at the feet, both hands full)
conjures = pebble

[gust]
name = spell.gust
symbols = air
power = 5
mana = 2
; at this power or more the breeze also shoves the monster ahead back `push`
; squares and meets shots flying at the party (weakens / flings them back)
push_power = 8
push = 1

[splash]
name = spell.splash
symbols = water
power = 7
mana = 2
; a burning brazier ahead goes out only at this power or more
brazier_power = 12

[firebolt]
name = spell.firebolt
symbols = fire,project
power = 14
mana = 8
speed = 8
range = 8
; A bolt of flame at ONE target - it does not explode (spell-updates, Michael;
; Hagalaz after it does: [firebolt_burst]). It always ignites what it strikes.
on_hit = burn 2 4

[earthbolt]
name = spell.earthbolt
symbols = earth,project
effect = projectile
element = earth
power = 18
mana = 10
speed = 9
range = 10

[waterbolt]
name = spell.waterbolt
symbols = water,project
effect = projectile
element = water
power = 12
mana = 7
speed = 9
range = 10

[airbolt]
name = spell.airbolt
symbols = air,project
effect = projectile
element = air
power = 4
mana = 6
speed = 12
range = 8
push = 1

[stoneskin]
name = spell.stoneskin
symbols = earth,protect
effect = shield
element = earth
power = 6
mana = 8
duration = 30

[fireshield]
name = spell.fireshield
symbols = fire,protect
effect = shield
element = fire
power = 6
mana = 8
duration = 30

[waterveil]
name = spell.waterveil
symbols = water,protect
effect = shield
element = water
power = 20
mana = 8
duration = 60

[windward]
name = spell.windward
symbols = air,protect
effect = shield
element = air
power = 3
mana = 8
duration = 60

[embersight]
name = spell.embersight
symbols = fire,sight
effect = sight
element = fire
power = 8
mana = 6
duration = 20

[farsight]
name = spell.farsight
symbols = air,sight
effect = sight
element = air
power = 3
mana = 6
duration = 20

[stonesight]
name = spell.stonesight
symbols = earth,sight
effect = sight
element = earth
power = 1
mana = 6
duration = 30

[scrying]
name = spell.scrying
symbols = water,sight
effect = sight
element = water
power = 1
mana = 6
duration = 20

; --- tier 3: a form spell + a MODIFIER rune (Game/Spell/ModifiedSpell.h) ------
; Ingwaz (multiple) on a bolt: a VOLLEY down the caster's lane - `count` bolts,
; one more per `count_per_power` of power past `power`, at most `count_max`, each
; at `share` of the power (Michael: each weaker). On a ward: the ward on every
; standing member, at `share`.
; Hagalaz (explode) on a bolt: it BURSTS on impact (blast_*, the Fire Burst
; tuning moved here), its damage scaling as cast power against `power` and its
; reach one square more per `blast_force_per_power` past it. On a ward: the
; ward's power spent as a burst round the caster (their own square spared);
; no ward is left (Michael).

[firebolt_volley]
name = spell.firebolt_volley
symbols = fire,project,multiple
power = 14
mana = 14
count = 2
count_per_power = 10
count_max = 5
share = 0.6
on_hit = burn 1 4

[firebolt_burst]
name = spell.firebolt_burst
symbols = fire,project,explode
power = 14
mana = 14
; Fire Burst's tuning, TUNED AGAINST THE PROPAGATION (docs/damage-system.md):
;   open room        5 at the centre, 3.5 around, 7 squares
;   dead end at feet 17.5 each
;   T-junction centre 30 - lethal, and only point-blank
; A BLAST HAS NO SIDE: it catches the party too.
on_hit = burn 2 4
blast_force = 7
blast_damage = 5
blast_falloff = 1.5
blast_rate = 0.06
blast_force_per_power = 12
blast_color = 1.0, 0.45, 0.1

[earthbolt_volley]
name = spell.earthbolt_volley
symbols = earth,project,multiple
power = 18
mana = 18
count = 2
count_per_power = 12
count_max = 5
share = 0.6

[earthbolt_burst]
name = spell.earthbolt_burst
symbols = earth,project,explode
power = 18
mana = 18
; shards of stone: a short, hard burst
blast_force = 4
blast_damage = 8
blast_falloff = 2
blast_rate = 0.05
blast_force_per_power = 15
blast_color = 0.75, 0.55, 0.35

[waterbolt_volley]
name = spell.waterbolt_volley
symbols = water,project,multiple
power = 12
mana = 14
count = 3
count_per_power = 10
count_max = 6
share = 0.5

[waterbolt_burst]
name = spell.waterbolt_burst
symbols = water,project,explode
power = 12
mana = 14
blast_force = 5
blast_damage = 5
blast_falloff = 1
blast_rate = 0.08
blast_force_per_power = 12
blast_color = 0.3, 0.55, 1.0

[airbolt_volley]
name = spell.airbolt_volley
symbols = air,project,multiple
power = 4
mana = 12
count = 3
count_per_power = 6
count_max = 6
share = 0.6
push = 1

[airbolt_burst]
name = spell.airbolt_burst
symbols = air,project,explode
power = 4
mana = 12
; a thunderclap: wide and weak
blast_force = 7
blast_damage = 2
blast_falloff = 0.25
blast_rate = 0.04
blast_force_per_power = 6
blast_color = 0.85, 0.9, 1.0

[stoneskin_party]
name = spell.stoneskin_party
symbols = earth,protect,multiple
power = 6
mana = 20
share = 0.75

[stoneskin_burst]
name = spell.stoneskin_burst
symbols = earth,protect,explode
power = 6
mana = 14
; the four squares round the caster are the first ring; force is squares
blast_force = 6
blast_damage = 6
blast_falloff = 2
blast_rate = 0.06
blast_force_per_power = 8
blast_color = 0.75, 0.55, 0.35

[fireshield_party]
name = spell.fireshield_party
symbols = fire,protect,multiple
power = 6
mana = 20
share = 0.75

[fireshield_burst]
name = spell.fireshield_burst
symbols = fire,protect,explode
power = 6
mana = 14
on_hit = burn 2 4
; the four squares round the caster are the first ring; force is squares
blast_force = 6
blast_damage = 6
blast_falloff = 1.5
blast_rate = 0.06
blast_force_per_power = 8
blast_color = 1.0, 0.45, 0.1

[waterveil_party]
