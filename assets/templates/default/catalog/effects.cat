; Status effects (docs/effects.md). NUMBERS AND LOOK ONLY — an effect's
; identity and behaviour are its class in src/Game/Effect/, exactly like a
; spell's. An entry naming no class is a warning, never a new effect.
;
; Fields: name = the display loc key (the sheet appends ".desc" for the long
; form), icon = the item id whose baked icon it borrows in the HUD strip
; ("" = the school-tinted square), stacking = refresh | school | stack.
;
; fade_party / fade_monster = the line saying it RAN OUT, one per side (a piece
; of the dungeon - a burning door - takes the monster's). Each is formatted with
; the bearer's name, then the effect's own name, and may use either or both
; ({0} / {1}). Absent = log.effect_fades, "<who> shakes off the <effect>". An
; effect that ends by SPENDING itself (a veil bursting, the wind stilling) says
; its own line instead, never this one.

; --- the Protect wards ------------------------------------------------------
; One kind per school, four different guards. They take their names from the
; spells that cast them, so the HUD keeps reading "Stone Skin" and the sheet
; finds the spell's existing description.

[stoneskin]
name = spell.stoneskin
icon = rune_protect
school = earth
fade_party = log.shield_fades
fade_monster = log.effect_fades
stacking = refresh

[fireshield]
name = spell.fireshield
icon = rune_protect
school = fire
fade_party = log.shield_fades
fade_monster = log.effect_fades
stacking = refresh

[waterveil]
name = spell.waterveil
icon = rune_protect
school = water
fade_party = log.shield_fades
fade_monster = log.effect_fades
stacking = refresh

[windward]
name = spell.windward
icon = rune_protect
school = air
fade_party = log.shield_fades
fade_monster = log.effect_fades
stacking = refresh

; --- damage over time -------------------------------------------------------
; magnitude is damage per second, RESISTED as `damage_type` each time it bites
; — so a ward raised mid-burn starts helping at once. The dps/duration are
; authored at the SOURCE (monsters.cat poison/bleed, weapons.cat element_dot);
; what lives here is what the effect is called, how it stacks, what it counts
; as, and whether it visibly burns.
;
; NOTE the damage type is NOT the HUD tint: bleeding rides fire red and wounds
; as pierce. (burn is the exception that needs no line here — it is resisted as
; whatever element lit it.)

; apply_party / apply_monster are the lines announcing that it took hold — the
; two sides word the same affliction differently, and each takes the bearer's
; name. `school` is the HUD tint a source lends when it has no element of its
; own (a monster's venom); an enchanted weapon overrides it with its element.

[poison]
name = effect.poison
damage_type = earth
school = earth
apply_party = log.poisoned
apply_monster = log.monster_poisoned
fade_party = log.effect_fades
fade_monster = log.effect_fades
stacking = refresh

[bleed]
name = effect.bleed
damage_type = pierce
school = fire
apply_party = log.bleeding
apply_monster = log.monster_bleeding
fade_party = log.effect_fades
fade_monster = log.effect_fades
stacking = refresh

[burn]
name = effect.burn
plume = 1
light = burning
apply_party = log.member_ignites
apply_monster = log.monster_ignites
fade_party = log.effect_fades
fade_monster = log.monster_burns_out
stacking = refresh

; --- an empty supply meter --------------------------------------------------
; docs/health-and-healing.md. DoTs like the three above, but their DURATION is
; meaningless: the supply tick holds them open while the meter is empty and
; erases them the moment it is not, so the meter is the truth and the effect is
; only its shadow. Their MAGNITUDE is likewise not authored here -- it is the
; balance.cat hunger_damage / thirst_damage knob, so the two sit beside the
; drain rates they have to be tuned against.
;
; Both deal `starve`, a type nothing resists by default (damagetypes.cat).
; Stacking MUST stay refresh: the tick re-applies while the meter is empty, and
; anything that piled up would multiply the bite every frame.

[starving]
name = effect.starving
damage_type = starve
school = earth
apply_party = log.starving
apply_monster = log.monster_starving
fade_party = log.effect_fades
fade_monster = log.effect_fades
stacking = refresh

[parched]
name = effect.parched
damage_type = starve
school = water
apply_party = log.parched
apply_monster = log.monster_parched
fade_party = log.effect_fades
fade_monster = log.effect_fades
stacking = refresh

; --- the see-through mark ---------------------------------------------------
; All four Sight spells share this kind; the school on the instance picks both
; the flavour the world reads and the name shown, so it stacks per school.

[sight]
name = spell.embersight
name_fire = spell.embersight
name_earth = spell.stonesight
name_air = spell.farsight
name_water = spell.scrying
icon = rune_sight
fade_party = log.sight_fades
fade_monster = log.effect_fades
stacking = school

; --- a doused fire's smoke ------------------------------------------------
; Borne by the FIRE, not by anyone: a fixture's on_douse lands it when the
; fire goes out. haze = 1 thickens its square's air by magnitude x the share
; of its time left, so it thins to nothing (the power and seconds are the
; fixture's, in fixtures.cat). Nothing at any damage stage.

[smoke]
name = effect.smoke
haze = 1
stacking = refresh

; --- the Sowilo lights (lighting-updates Phase 6) ---------------------------
; One kind for the four light spells, named by school like [sight]. It does
; nothing to its bearer: the world lights the party from it. `scale_power` is
; the cast power at which the light is its profile's own size.
[light]
name = spell.firelight
name_fire = spell.firelight
name_earth = spell.stonelight
name_air = spell.skylight
name_water = spell.tidelight
icon = rune_light
fade_party = log.light_fades
fade_monster = log.effect_fades
stacking = school
scale_power = 8
; FIRE's light kindles an unlit fire within a step (a brazier only at
; kindle_brazier_power) and every scorch_every seconds burns each monster
; beside the party for scorch_damage x (power / scale_power).
kindle_brazier_power = 14
scorch_every = 1.5
scorch_damage = 1.5
; WATER's light: stamina comes back `soothe` x faster in it (1 = twice as
; fast), it clears `clear_haze` of turbidity round the party, and it puts
; out any fire on the party.
soothe = 1
clear_haze = 2
; AIR's light: every crackle_every seconds a shock of crackle_damage x
; (power / scale_power) at the nearest monster in its reach and sight; its
; flicker runs warn_rate x fast while a monster near has noticed the party.
crackle_every = 2
crackle_damage = 2
warn_rate = 3
; EARTH's light is not carried: it is a stone SET DOWN where it is cast,
; drawn as the `stone_item` item's model glowing in its colour (an item the
; world lacks = the light alone), and every square its light reaches is mapped.
stone_item = rock

; A light spell's flare blinds a monster: it does nothing while this lasts.
[dazzle]
name = effect.dazzle
fade_party = log.effect_fades
fade_monster = log.monster_dazzle_fades
stacking = refresh
