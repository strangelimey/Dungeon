; Stairs and pits: cross-level links with auto-authored pairs.

[stairs_down]
display = Stairs Down
category = stairs
model = stairs_down
texture = wall_stone
solid = 0
authored = 0
up = 0
pair = stairs_up
hole = floor

[stairs_up]
display = Stairs Up
category = stairs
model = stairs
texture = wall_stone
solid = 0
authored = 0
up = 1
pair = stairs_down
; The flight climbs a full storey and carries on into a stairwell above, so the
; ceiling block has to go. This was `none`, which capped the stairs with a solid
; roof and made them read as steps to nowhere.
hole = ceiling

[pit]
display = Pit
category = pit
model = pit
texture = wall_stone
solid = 0
authored = 0
up = 0
pair = pit_ceiling
hole = floor
fall = 1

[pit_ceiling]
display = Ceiling Hole
category = pit
model = pit_ceiling
texture = wall_stone
solid = 0
authored = 0
up = 1
pair = pit
hole = ceiling
traverse = 0
