; Spells — the recipe table mapping a SYMBOL SEQUENCE to an effect. A character
; casts by building a sequence from the symbols they have memorized (per-member
; vocabulary); an EXACT match here resolves to a spell, anything else fizzles.
; Fields:
;   name    = loc key for the display name (spell.flame -> "Flame")
;   symbols = comma-separated symbol sequence (fire|earth|air|water); the key
;   effect  = effect kind, dispatched in C++: projectile (a bolt) or shield
;             (a ward on the CASTER; the school picks its behaviour)
;   element = the elemental flavour (fire|earth|air|water) — drives bolt colour
;   power   = base damage on a clean hit (fed into the strike resolver)
;   mana    = mana points the cast costs (no cast below this)
;   speed   = bolt travel speed in metres/sec
;   range   = bolt reach in metres before it fizzles
;   push    = cells a struck (surviving) monster is shoved along the bolt's
;             travel; walls/doors/occupied cells stop the shove early (0 = none)
;   duration= shield lifetime in seconds (shield spells; power = its magnitude:
;             earth reads it as an armor bonus, fire as retaliation damage)
; SCHOOL RULE: the four element runes are mutually exclusive — a sequence
; carries exactly ONE, in first position (the first rune picks the spell's
; school). The loader skips any recipe that breaks it. Tier 1 is therefore the
; four elements as single-symbol bolts; deeper spells arrive with the tier-2
; (non-school) symbols. THE SPELL LIST — what each spell is meant to do and
; how it grows with the caster's school power — lives in docs/spells.md; the
; projectile numbers below are the placeholder "day one" forms.

[flame]
name = spell.flame
symbols = fire
effect = projectile
element = fire
power = 8
mana = 4
speed = 7
range = 8

[rock]
name = spell.rock
symbols = earth
effect = projectile
element = earth
power = 12
mana = 6
speed = 5
range = 7

[gust]
name = spell.gust
symbols = air
effect = projectile
element = air
power = 5
mana = 3
speed = 11
range = 11

[splash]
name = spell.splash
symbols = water
effect = projectile
element = water
power = 7
mana = 4
speed = 7
range = 9

; --- Tier 2: <school>,project — the shared Project form rune ("throw it
; ahead") behind each school. Stronger, costlier directed casts; the element
; (= the leading school rune) still drives the bolt colour. `push` shoves a
; struck-and-surviving monster that many cells along the bolt's travel (the
; air school's displacement identity — its "bolt" moves the target, it
; barely hurts it). Growth forms (flamethrower, deluge, ...) in docs/spells.md.

[fireburst]
name = spell.fireburst
symbols = fire,project
effect = projectile
element = fire
power = 14
mana = 8
speed = 8
range = 8

[slingshot]
name = spell.slingshot
symbols = earth,project
effect = projectile
element = earth
power = 18
mana = 10
speed = 9
range = 10

[waterbolt]
name = spell.waterbolt
symbols = water,project
effect = projectile
element = water
power = 12
mana = 7
speed = 9
range = 10

[push]
name = spell.push
symbols = air,project
effect = projectile
element = air
power = 4
mana = 6
speed = 12
range = 8
push = 1

; --- Tier 2: <school>,protect — the shared Protect form rune ("guard the
; caster"). One ward per member (a recast replaces it); the school picks HOW
; it guards and how `power` reads: earth HARDENS (armor bonus), fire
; RETALIATES (a monster landing a melee blow on the warded member burns for
; power), water ABSORBS (a damage pool it spends soaking hits — BURSTS when
; spent), air DEFLECTS (charges it spends turning ranged bolts aside — the
; wind STILLS when spent). Water/air can end early by spending; every ward
; also fades when its duration runs out.

[stoneskin]
name = spell.stoneskin
symbols = earth,protect
effect = shield
element = earth
power = 6
mana = 8
duration = 30

[fireshield]
name = spell.fireshield
symbols = fire,protect
effect = shield
element = fire
power = 6
mana = 8
duration = 30

[waterveil]
name = spell.waterveil
symbols = water,protect
effect = shield
element = water
power = 20
mana = 8
duration = 60

[windward]
name = spell.windward
symbols = air,protect
effect = shield
element = air
power = 3
mana = 8
duration = 60
