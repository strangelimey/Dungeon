; Spells: symbol-sequence recipes -> effect + element + power/mana/speed/range.
;
; `on_hit` is the PAYLOAD the cast's carrier delivers, authored exactly as a
; weapon's is: "<effect id> <magnitude> <seconds> [chance]", comma-separated.
; It lands twice over — on the body a bolt strikes, and on everything in the
; cell a bolt BURSTS in when it stops without striking anything (a wall, or the
; end of its reach). The spell's school lends the flavour, so one authored
; `burn` is fire from a firebolt and frost from a waterbolt.

[flame]
name = spell.flame
symbols = fire
effect = projectile
element = fire
power = 8
mana = 4
speed = 7
range = 8
on_hit = burn 2 4 0.5

[rock]
name = spell.rock
symbols = earth
effect = projectile
element = earth
power = 12
mana = 6
speed = 5
range = 7

[gust]
name = spell.gust
symbols = air
effect = projectile
element = air
power = 5
mana = 3
speed = 11
range = 11

[splash]
name = spell.splash
symbols = water
effect = projectile
element = water
power = 7
mana = 4
speed = 7
range = 9

[fireburst]
name = spell.fireburst
symbols = fire,project
effect = projectile
element = fire
power = 14
mana = 8
speed = 8
range = 8
; The directed fire cast always ignites — it is the tier-2 spell, and the
; certainty is most of what it buys over [flame]'s coin-flip.
on_hit = burn 3 6

[slingshot]
name = spell.slingshot
symbols = earth,project
effect = projectile
element = earth
power = 18
mana = 10
speed = 9
range = 10

[waterbolt]
name = spell.waterbolt
symbols = water,project
effect = projectile
element = water
power = 12
mana = 7
speed = 9
range = 10

[push]
name = spell.push
symbols = air,project
effect = projectile
element = air
power = 4
mana = 6
speed = 12
range = 8
push = 1

[stoneskin]
name = spell.stoneskin
symbols = earth,protect
effect = shield
element = earth
