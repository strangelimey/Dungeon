[skel_mage]
; hangs back warding and mending; casts to survive
offense = 0.45
display = Skeleton Mage
category = skeleton
model = skeleton
texture = skeleton
hp = 14
damage = 8
accuracy = 75
defense = 0.1
armor = 0
attackcd = 2.4
aggro = 9
movecd = 0.5
iq = 130
archetype = caster
keeprange = 5
spell = flame
resists = pierce 0.5, slash 0.25, bash -0.5
; It has no skills, so `powers` is where "this one is dangerous with fire" lives —
; the attacker's mirror of the resists above. Its flame bolts land harder; its
; feeble staff does not.
powers = fire 0.45, bash -0.3

