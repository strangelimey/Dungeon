; Monsters: model + texture set.
; Per-type THREAT shading (optional, default 1 = the balance.cat global as-is):
;   threat_scale     x how hard a landed hit builds this kind's aggro
;   threat_threshold x the aggro needed before it LOCKS onto one member
;                      (< 1 = single-minded, locks fast; > 1 = erratic, random longer)
;   threat_switch    x the margin another member must beat the lock by to steal it
;   threat_decay     x how fast the grudge fades (> 1 = short memory)
; Editable live in the editor's monster config dialog (Behavior tab).
;
; modelscale — uniform trim on top of UnitScale (Game/DungeonMap.h). A model
; authored to convention needs none, and none here has one: every model on disk
; is unit space (1.0 = one dungeon square, docs/authoring-scale.md), which the
; bakers and the import tools all target directly. Reach for a trim to art-
; direct one creature bigger or smaller than its art, never to correct a
; mis-sized import — fix that where it was sized.

[skeleton]
display = Skeleton
category = skeleton
tags = undead
model = skeleton
texture = skeleton
hp = 16
damage = 5
accuracy = 0.7
defense = 0.1
armor = 0
attackcd = 1.6
aggro = 6
movecd = 0.45
iq = 135
fleebelow = 0.3
resists = pierce 0.5, slash 0.25, bash -0.5
dmgtype = slash

