; --- light -----------------------------------------------------------------
; THE HELD TORCH IS THE PARTY'S LIGHT (spell-updates): with nothing lit in a
; hand, the party sees by the level's ambient alone. Three tiers, each an unlit
; and a lit item (lit_as / unlit_as) sharing one model. A lit one burns
; `burn_time` seconds of game time while it is HELD (the item's charge counts
; down), dims over its last tenth and becomes `spent_as`. Stowed in a pack or
; set down it goes out, keeping what is left; Puff of Flame lights it again.
[torch_crude]
name = item.torch_crude
category = light
weight = 0.7
holdable = 1
model = torch_crude
lit_as = torch_crude_lit

[torch_crude_lit]
name = item.torch_crude_lit
category = light
weight = 0.7
holdable = 1
model = torch_crude
burn_time = 600
unlit_as = torch_crude
spent_as = torch_stub

[torch]
name = item.torch
category = light
weight = 0.8
holdable = 1
model = torch
lit_as = torch_lit

[torch_lit]
name = item.torch_lit
category = light
weight = 0.8
holdable = 1
model = torch
burn_time = 900
unlit_as = torch
spent_as = torch_stub

[torch_fine]
name = item.torch_fine
category = light
weight = 1.0
holdable = 1
model = torch_fine
lit_as = torch_fine_lit

[torch_fine_lit]
name = item.torch_fine_lit
category = light
weight = 1.0
holdable = 1
model = torch_fine
burn_time = 1500
unlit_as = torch_fine
spent_as = torch_stub

; What a torch leaves when it burns out. Junk: it cannot be lit again. (Wears
; the crude torch's model until it has its own.)
[torch_stub]
name = item.torch_stub
category = light
weight = 0.2
holdable = 1
model = torch_crude

; --- quest content (docs/world-map.md "Quests") ------------------------------
; The three hooks an item can carry, all applied the moment it is LIFTED:
;   quest    = <id>:<stage>   move a quest to a named stage
;   flag     = <id>           turn a flag on (flags.cat; a hand-written <key>=<value> still sets that value)
;   reveals  = <location>     put a world-map location on the party's map
; They are independent: one item may do all three, or any one of them.

; THE CLUE. It reveals the crypt's back way — the "you might find a map or a
; clue that will add them" case, straight out of the design notes. Note that it
; reveals a PLACE without revealing the ground around it, which is exactly why
; discovery and the fog are separate fields.
[crypt_token]
name = item.crypt_token
category = key
weight = 0.1
holdable = 1
quest = sunken_relic:heard
reveals = crypt_back

; THE QUEST ITEM. Found in the dungeon, it moves the quest on for the whole
; world — the case the notes open with.
[sunken_relic]
name = item.sunken_relic
category = key
weight = 2.0
holdable = 1
quest = sunken_relic:found
flag = relic_lifted=1
