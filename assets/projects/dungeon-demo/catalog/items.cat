holdable = 1

; THROWING (ui-updates Phase 10). Anything can be thrown; a throw is an attack.
;   throw        = the attacks.cat attack it flies as - its damage TYPE and
;                  numbers (absent: a weapon's first command, else `throw`,
;                  bash). A throwing star would say `throw = stab` (pierce).
;   throw_spell  = a spell whose payload it carries (its on_hit and blast)
;                  instead of its own on_hit: a fire flask bursts into fire.
;   throw_breaks = 1: it shatters where it stops instead of landing.
; Speed is the thrower's skill against the weight (balance.cat throw_speed*).
;
; A stone to throw: what is lying about for it. Bash by weight (throw_base /
; throw_weight). The model is script-built: tools/BuildRock.py.
[rock]
name = item.rock
category = misc
weight = 1.5
holdable = 1
model = rock

; A flask of fire: it shatters where it stops and bursts as fireburst does -
; blast and all, which catches the party too if it bursts close.
[fire_flask]
name = item.fire_flask
category = misc
weight = 0.6
holdable = 1
throw_spell = fireburst
throw_breaks = 1

; A flask of poison gas: it shatters where it stops and lets go a CLOUD - a
; persistent blast that creeps out slowly (blast_rate s a step), fills the
; squares it reaches and keeps biting in them, a whiff of damage each time and a
; poisoning that each breath refreshes. Poison is earth here (effects.cat). A
; cloud in a corridor runs along it; keep the party out of it.
[poison_flask]
name = item.poison_flask
category = misc
weight = 0.6
holdable = 1
throw_breaks = 1
on_hit = poison 2 10
blast_force = 6
blast_damage = 1
blast_falloff = 0.1
blast_rate = 0.6
blast_persist = 1
blast_linger = 8
blast_type = earth
blast_color = 0.35, 0.9, 0.2

; --- food and drink ---------------------------------------------------------
; `nutrition` and `hydration` are what CONSUMING it restores, out of 100
; (docs/health-and-healing.md). BOTH fields on every consumable, because most
; real food is partly one and partly the other -- an apple waters a little,
; bread does not at all, a waterskin is nearly pure water. The `command` verb is
; only how it reads in the hand menu; these two are what it actually does, so
; `eat` and `drink` run the same code.
;
; An item with neither is not consumable: the action is REFUSED rather than
; silently eating it, which is also what a full member gets.

[apple]
name = item.apple
category = food
weight = 0.3
holdable = 1
command = eat
nutrition = 8
hydration = 4

[bread]
name = item.bread
category = food
weight = 0.5
holdable = 1
command = eat
nutrition = 18
hydration = 0

[waterskin]
name = item.waterskin
category = drink
weight = 1.2
holdable = 1
command = drink
nutrition = 0
hydration = 45

; --- quest content (docs/world-map.md "Quests") ------------------------------
; The three hooks an item can carry, all applied the moment it is LIFTED:
;   quest    = <id>:<stage>   move a quest to a named stage
;   flag     = <id>           turn a flag on (flags.cat; a hand-written <key>=<value> still sets that value)
;   reveals  = <location>     put a world-map location on the party's map
; They are independent: one item may do all three, or any one of them.

; THE CLUE. It reveals the crypt's back way — the "you might find a map or a
; clue that will add them" case, straight out of the design notes. Note that it
; reveals a PLACE without revealing the ground around it, which is exactly why
; discovery and the fog are separate fields.
[crypt_token]
name = item.crypt_token
category = key
weight = 0.1
holdable = 1
quest = sunken_relic:heard
reveals = crypt_back

; THE QUEST ITEM. Found in the dungeon, it moves the quest on for the whole
; world — the case the notes open with.
[sunken_relic]
name = item.sunken_relic
category = key
weight = 2.0
holdable = 1
quest = sunken_relic:found
flag = relic_lifted=1
