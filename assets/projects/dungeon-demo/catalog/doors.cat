; Doors: a leaf plus the shared frame. Blocking is keyed to the CELL, so how a
; leaf gets out of the way is pure presentation and lives here as data:
;   motion        slide (into the flanking wall) | rise (into the ceiling block,
;                 which hides it) | split (two halves parting into their jambs)
;   travel        how far the leaf moves, in SQUARES — for a split, how far EACH
;                 half goes, so the model is authored as the LEFT HALF only and
;                 the render turns a second copy a half turn onto the right
;   open_seconds  how long the full throw takes
;   trim          a second model drawn with the leaf, carrying its OWN texture
;                 (a wooden door's iron straps cannot be iron in a wood-textured
;                 mesh — the import path binds one set per model)
;   frame         which surround it hangs in; see the frames section below

[wooden_door]
display = Wooden Door
category = door
model = door_panel_half
texture = wood_planks_old8
authored = 0
motion = split
travel = 0.4
open_seconds = 0.8
trim = door_band_half
frame = door_frame_split

[portcullis]
display = Portcullis
category = door
model = door_panel
texture = sconce
authored = 0
motion = rise
travel = 1.0
open_seconds = 1.4
trim = door_band
frame = door_frame_temple

[stone_door]
display = Stone Door
category = door
model = door_panel
texture = wall_stone_granite
authored = 0
motion = slide
travel = 0.75
open_seconds = 2.0
trim = door_bosses
frame = door_frame_granite

; --- frames ----------------------------------------------------------------
; The surround a leaf hangs in, named by the door type's `frame` (defaulting to
; [door_frame]). Since the field is a catalog reference and not a texture name,
; a variant is free to change the STONE, the MESH, or both.
;
; THE MESH HAS TO MATCH THE MOTION, because a door needs somewhere to go: the
; frame is cut with a MORTICE on whichever side its leaf travels into, and a
; frame whose slot is on the wrong side leaves the leaf sliding into solid
; stone. tools/BuildDoorFrame.py takes --left/--right/--head and emits one
; model per combination:
;   door_frame        no slot   — a doorway that never opens, or a hinged leaf
;   door_frame_slide  --right   — `slide` moves the leaf +X
;   door_frame_split  --left --right — `split` sends a half each way
;   door_frame_rise   --head    — `rise` takes the leaf up
;
; authored = 1 on all of them: a closed shell with correct winding back-culls,
; which the three boxes this replaced could not.

[door_frame]
display = Door Frame
model = door_frame
texture = wall_stone
authored = 1
hidden = 1

; The wooden double door, in the wall's own stone.
[door_frame_split]
display = Door Frame (split)
model = door_frame_split
texture = wall_stone
authored = 1
hidden = 1

; The portcullis stands in a gatehouse, not a corridor.
[door_frame_temple]
display = Door Frame (temple)
model = door_frame_rise
texture = wall_temple_ancient
authored = 1
hidden = 1

; The vault frame matches its slab, so the door reads as cut from the surround.
[door_frame_granite]
display = Door Frame (granite)
model = door_frame_slide
texture = wall_stone_granite
authored = 1
hidden = 1

; --- leaf trim -------------------------------------------------------------
; Drawn with the leaf it belongs to (the type's `trim`), and hidden from the
; palette: trim is never placed on its own. It exists to give a leaf a legible
; EDGE — and on a split door, a legible CENTRE — since a flat rectangle loses
; both against the frame. Each carries its own texture, which is the whole
; reason it is a separate model: an iron strap cannot be iron inside a
; wood-textured mesh.
;
; The iron is `sconce`, the game's uniform worn-metal set, NOT `rusted_iron`.
; rusted_iron is a scan of a corrugated iron WALL — big sheet panels, hard
; vertical seams, a pale weathered strip down one third — so at any tile rate
; each bar of the band lands on a different panel of the scan and the strap
; reads as assembled from mismatched pieces rather than forged in one. A band
; wants a texture with NO features larger than the bar is wide. As a bonus this
; is the set the sconces and braziers already wear, so the ironwork matches.

[door_band]
display = Door Band (iron)
model = door_band
texture = sconce
authored = 0
hidden = 1

[door_band_half]
display = Door Band, half leaf (iron)
model = door_band_half
texture = sconce
authored = 0
hidden = 1

; Bronze, not iron: banding a stone slab reads as ironwork bolted to rock, so a
; sealed vault door marks its corners and hangs a ring instead.
[door_bosses]
display = Door Bosses (bronze)
model = door_bosses
texture = brass
authored = 0
hidden = 1
