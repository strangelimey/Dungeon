; Wall surface types: texture set + worn-block height displacement.
; Optional geometry-style knobs (editor: right-click a Walls palette row):
;   wear    = 0..1  displacement amount (0 = flat panel; default 1)
;   columns = 0|1   the wall's edge pillars / border strips (default 1)
; Absent = full worn relief with columns. Changing them re-bakes the texture's
; worn_<texture>_<tier>.gltf, so a value applies after the editor's rebake (a
; plain `AssetBaker <assets>` bakes the defaults).

[wall_brick]
display = Brick
texture = wall_brick
height_scale = 0.055
category = brick

[wall_stone]
display = Cut Stone
texture = wall_stone
height_scale = 0.055
category = stone

[wall_moss]
display = Mossy Wall
texture = wall_moss
height_scale = 0.055
category = stone

[wall_cobblestone]
display = Cobblestone
texture = cobblestone_wall
height_scale = 0.055
category = stone

[wall_stacked_stone]
display = Stacked Stone
texture = stacked_stone
height_scale = 0.055
category = stone

[wall_brick_red]
display = Red Brick
texture = brick_red
height_scale = 0.055
category = brick

[wall_plaster]
display = Plaster
texture = plaster
height_scale = 0.04
category = smooth

[wall_rock]
display = Cave Rock
texture = rock_cliff
height_scale = 0.06
category = rock

[wall_marble]
display = Marble
texture = marble_white
height_scale = 0.02
category = smooth
