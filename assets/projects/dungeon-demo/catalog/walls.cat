; Wall surface types: texture set + worn-block height displacement.
; Optional geometry-style knobs (editor: right-click a Walls palette row):
;   wear    = 0..1  displacement amount (0 = flat panel; default 1)
;   relief  = metres how far the stones stand proud (default per kind)
; Walls are PLAIN: the old `columns` edge pillars were retired 2026-08-05 — put
; a pillar down as a DECORATION instead, so one model serves every wall type.
; Absent = full worn relief. Changing them re-bakes the texture's
; worn_<texture>_<tier>.gltf, so a value applies after the editor's rebake (a
; plain `AssetBaker <assets>` bakes the defaults).

[wall_brick]
display = Brick
texture = wall_brick
height_scale = 0.055
category = brick

[wall_stone]
display = Cut Stone
texture = wall_stone
height_scale = 0.055
category = stone

[wall_moss]
display = Mossy Wall
texture = wall_moss
height_scale = 0.055
category = stone

[wall_cobblestone]
display = Cobblestone
texture = cobblestone_wall
height_scale = 0.055
category = stone

[wall_stacked_stone]
display = Stacked Stone
texture = stacked_stone
height_scale = 0.055
category = stone

[wall_brick_red]
display = Red Brick
texture = brick_red
height_scale = 0.055
category = brick

[wall_plaster]
display = Plaster
texture = plaster
height_scale = 0.04
category = smooth

[wall_rock]
display = Cave Rock
texture = rock_cliff
height_scale = 0.06
category = rock

[wall_marble]
display = Marble
texture = marble_white
height_scale = 0.02
category = smooth

; --- batch 2: scanned 4K sets, large real-world tiles -----------------------
; The id and the texture set share a name here, unlike the older entries above
; (wall_cobblestone -> cobblestone_wall), because keeping the two in step is one
; less thing to mix up when a palette record names one and a catalog the other.
; height_scale is the SHADER's parallax depth — per-draw, no rebake, and by
; construction invisible head-on; the real silhouette comes from the worn mesh's
; relief in ModelBaker's specs[]. The two are deliberately not the same number.

[wall_cobble_mixed]
display = Mixed Cobblestone
texture = wall_cobble_mixed
height_scale = 0.07
category = stone

