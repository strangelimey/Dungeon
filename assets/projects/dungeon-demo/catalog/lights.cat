; Lights: what each kind of light LOOKS like (docs/lighting-updates-plan.md
; Phase 2, Game/LightProfile.h). A source names one of these - fixtures.cat,
; items.cat, weapons.cat and armor.cat `light = <id>`, effects.cat `light` on a
; plume effect - so its colour comes from its TYPE.
;   color       'r, g, b' in 0..1, or `source` for the source's own colour (a
;               burn's school, a rune's element)
;   intensity   brightness at the source
;   radius      reach in SQUARES. A placed sconce or brazier has its own reach
;               (the fixture inspector's Brightness), which wins over this.
;   pulse       steady / flicker / breathe / strobe / storm
;   pulse_rate  how fast it pulses (1 = the pulse's own pace)
;   pulse_depth how far it dips, 0..1
;   wander      how far the light's origin dances, in squares (the fires'
;               moving shadows); 0 = still
;   shadow      1 = it may cast shadows (8 cubes go to the nearest such lights)
;   long_fade   1 = its shadow fades over most of its reach (a brazier's)

[fire_sconce]
display = Wall sconce fire
category = fire
color = 1.0, 0.62, 0.28
intensity = 1.8
radius = 3
pulse = flicker
pulse_depth = 0.1
wander = 0.0112
shadow = 1

[fire_brazier]
display = Brazier fire
category = fire
color = 1.0, 0.527, 0.224
intensity = 2.3
radius = 6
pulse = flicker
pulse_depth = 0.1
wander = 0.0168
shadow = 1
long_fade = 1

; A torch in a hand (or on the cursor). It dims as it burns down, by its
; charge (the last tenth of its burn_time), on top of this.
[torch]
display = Carried torch
category = fire
color = 1.0, 0.62, 0.28
intensity = 2.6
radius = 3.6
pulse = flicker
pulse_depth = 0.08
shadow = 1

; A monster on fire: a moving lamp in the colour of what lit it. Shadowless,
; so it never takes a shadow cube from the torch and the fires.
[burning]
display = Burning body
category = magic
color = source
intensity = 1.9
radius = 2.2
pulse = flicker
pulse_rate = 1.09
pulse_depth = 0.15
shadow = 0

; A rune or an enchanted weapon lying on the floor, breathing in its element's
; colour in step with the tablet's own glow.
[floor_glow]
display = Glow on the floor
category = magic
color = source
intensity = 2.415
radius = 1.92
pulse = breathe
pulse_depth = 0.81
shadow = 0

; Ember Sight's fill: warm light in the room the peephole reveals.
[ember_sight]
display = Ember Sight
category = magic
color = 1.0, 0.55, 0.25
intensity = 2.0
radius = 2.2
pulse = steady
shadow = 0

; A hand spell's puff of its element (Puff of Flame cast at nothing): a flash in
; the school's colour that falls away over half a second.
[hand_puff]
display = Hand spell puff
category = magic
color = source
intensity = 1.3
radius = 1.4
pulse = steady
shadow = 0

; THINGS IN FLIGHT (Phase 4). Each bolt is its own light from launch to landing
; (a volley's bolts each light their own stretch), shadowless and small so a
; fight full of them stays cheap. A bolt takes its SCHOOL'S unless spells.cat
; names its own (`light = <id>`); a thrown item lights by its kind's `light`.
[bolt_fire]
display = Fire bolt
category = flight
color = 1.0, 0.35, 0.15
intensity = 1.7
radius = 2
pulse = flicker
pulse_rate = 1.6
pulse_depth = 0.2
shadow = 0

[bolt_water]
display = Water bolt
category = flight
color = 0.3, 0.55, 1.0
intensity = 1.5
radius = 1.8
pulse = breathe
pulse_rate = 2.5
pulse_depth = 0.25
shadow = 0

[bolt_air]
display = Air bolt
category = flight
color = 0.85, 0.92, 1.0
intensity = 1.4
radius = 1.8
pulse = storm
pulse_rate = 2
pulse_depth = 0.35
shadow = 0

[bolt_earth]
display = Earth bolt
category = flight
color = 0.85, 0.6, 0.3
intensity = 1.2
radius = 1.5
pulse = steady
shadow = 0

; A monster's plain shot (no spell): the colour of its own glow.
[bolt_shot]
display = Monster shot
category = flight
color = source
intensity = 1.5
radius = 1.6
pulse = flicker
pulse_depth = 0.15
shadow = 0
