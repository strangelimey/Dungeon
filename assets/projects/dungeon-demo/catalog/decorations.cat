; Decoration props. Fields:
;   model    = assets/models/<model>.gltf
;   texture  = PBR set in assets/textures (omit -> flat glTF material color)
;   solid    = 1 blocks the party, 0 lets it pass (open passages); a level
;              record's "solid=" overrides this default
;   authored = 1 imported mesh (consistently wound -> back-face culled),
;              0 procedural (CULL_NONE)
;   category = free-form group token; entries sharing one collapse under a
;              sub-accordion in the editor palette (like items.cat)
;   facing_arrow = 0 hides the editor map's green facing arrow on instances of
;              this type (radially symmetric props — columns, pots, rocks —
;              have no meaningful facing). Default 1. The instance inspector's
;              checkbox beside the Facing dropdown edits this per type.
; Procedural props (column/archway/fountain/statue/wood_door/barrel/crate/chest)
; share dungeon-stone or wood-plank sets; the rest are authored imports that
; carry their own same-named set.

[column]
display = Column
model = column
texture = wall_stone
solid = 1
authored = 0
category = architecture
facing_arrow = 0

[archway]
display = Archway
model = archway
texture = wall_stone
solid = 0
authored = 0
category = architecture

[fountain]
display = Fountain
model = fountain
texture = wall_stone
solid = 1
authored = 0
category = architecture
facing_arrow = 0

[statue]
display = Statue
model = statue
texture = wall_stone
solid = 1
authored = 0
category = statue

[wood_door]
display = Wooden Door (prop)
model = door
texture = wood_planks
solid = 1
authored = 0
category = gate

[barrel]
display = Barrel
model = barrel
texture = wood_planks
solid = 1
authored = 0
category = container
facing_arrow = 0

[crate]
display = Crate
model = crate
texture = wood_planks
solid = 1
authored = 0
category = container

[chest]
display = Chest
model = chest
texture = wood_planks
solid = 1
authored = 0
category = container

[ancient_pot]
display = Ancient Pot
model = ancient_pot
texture = ancient_pot
solid = 1
authored = 1
category = container
facing_arrow = 0

[banner]
display = Banner
model = banner
texture = banner
solid = 1
authored = 1
category = clutter

[pot]
display = Pot
model = pot
texture = pot
solid = 1
authored = 1
category = container
facing_arrow = 0

[mossy_rock]
display = Mossy Rock
model = mossy_rock
texture = mossy_rock
solid = 1
authored = 1
category = rock
facing_arrow = 0

[boulder]
display = Boulder
model = boulder
texture = boulder
solid = 1
authored = 1
category = rock
facing_arrow = 0

; --- variants pairing existing models with new scanned sets ---
[column_marble]
display = Marble Column
model = column
texture = marble_pillar
solid = 1
authored = 0
category = architecture
facing_arrow = 0

[statue_marble]
display = Marble Statue
model = statue
texture = marble_white
solid = 1
authored = 0
category = statue

[iron_door]
display = Iron Door
model = door
texture = rusted_iron
solid = 1
authored = 0
category = gate

; Iron portcullis — real-geometry bars (not an alpha cutout) so torchlight
; casts true shadows through the gaps. Procedural box build -> authored=0
; (CULL_NONE). Blocks the passage when placed (solid=1).
[portcullis]
display = Portcullis
model = portcullis
texture = rusted_iron
solid = 1
authored = 0
category = gate

; --- authored multi-material weapons (fab.com Fantasy Assassin pack) ---
; multimaterial=1 loads <model>.glb and renders each part with its OWN glTF
; material (steel blade, brass guard, leather/wood grip) — no single texture set.
[viking_dagger]
display = Viking Dagger
model = viking_dagger
multimaterial = 1
solid = 0
authored = 1
category = weapon

[khukri]
display = Khukri
model = khukri
multimaterial = 1
solid = 0
authored = 1
category = weapon

[snake_dagger]
display = Snake Dagger
model = snake_dagger
multimaterial = 1
solid = 0
authored = 1
category = weapon

[french_dagger]
display = French Dagger
model = french_dagger
multimaterial = 1
solid = 0
authored = 1
category = weapon

; coil of rope (procedural torus) — low, steppable detail
[rope]
display = Coil of Rope
model = rope
texture = rope
solid = 0
authored = 0
category = clutter
facing_arrow = 0
