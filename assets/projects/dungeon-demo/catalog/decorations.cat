; Decoration props: model + texture set + solid/authored flags.
; texture = none declares the model renders on its flat glTF material by
; design (no missing-set warning).

[column]
display = Column
model = column
texture = wall_stone
solid = 1
authored = 0
category = architecture
facing_arrow = 0

[archway]
display = Archway
model = archway
texture = wall_stone
solid = 0
authored = 0
category = architecture

[fountain]
display = Fountain
model = fountain
texture = wall_stone
solid = 1
authored = 0
category = architecture
facing_arrow = 0

[statue]
display = Statue
model = statue
texture = wall_stone
solid = 1
authored = 0
category = statue

[wood_door]
display = Wooden Door (prop)
model = door
texture = wood_planks
solid = 1
authored = 0
category = gate
; A door PROP is a wall-plane object (0.28 deep), so it hangs on a face rather
; than standing mid-cell — a sealed/false door. A door you can actually open is
; the functional entity in doors.cat, not this.
mount = wall

