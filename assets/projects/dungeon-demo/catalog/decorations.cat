; Decoration props: model + texture set + solid/authored flags.
; texture = none declares the model renders on its flat glTF material by
; design (no missing-set warning).

[column]
display = Column
model = column
texture = wall_stone
solid = 1
authored = 0
category = architecture
facing_arrow = 0

; Octagonal turned pillar authored in Blender: plinth, tapered shaft, flared
; capital. Exactly kWallH tall, so it meets the ceiling with no gap.
; authored = 1 — a closed solid with correct normals, so it back-face culls.
[pillar]
display = Pillar
model = pillar
texture = marble_pillar
solid = 1
authored = 1
category = architecture
facing_arrow = 0

; The same mesh wearing the dungeon's wall stone instead of marble — a texture
; set is just a binding for a decoration, so a variant costs an entry, not a
; model. This is the comparison against the procedural [column] above.
[pillar_stone]
display = Pillar (Stone)
model = pillar
texture = wall_stone
solid = 1
authored = 1
category = architecture
facing_arrow = 0

[archway]
display = Archway
model = archway
texture = wall_stone
solid = 0
authored = 0
category = architecture

[wall_arch]
display = Wall Arch
model = wall_arch
texture = stacked_stone
solid = 0
category = architecture

; The rustic variant: the same passage opening ringed with stacked voussoirs
; (jambs to the floor, proud keystone at the crown). Rings out to z +/-0.11
; because the stone band stands proud of the wall face.
[wall_arch_rustic]
display = Wall Arch (Rustic)
model = wall_arch_rustic
texture = stacked_stone
solid = 0
category = architecture

; A moulded pedestal, waist height — script-authored (tools/BuildPlinth.py),
; so its proportions are a profile table rather than a hand-modelled .blend.
[plinth]
display = Plinth
model = plinth
texture = marble_pillar
solid = 1
category = architecture
facing_arrow = 0

; Weathered version of the rustic arch — same stones, tilted and surface-noised
; by tools/RoughenArch.py. Kept as its own model so both looks stay available.
[wall_arch_rough]
display = Wall Arch (Rough)
model = wall_arch_rough
texture = stacked_stone
solid = 0
category = architecture

; Script-authored (tools/BuildFountain.py) — one revolved profile each, so the
; proportions are a table rather than modelled geometry.
[fountain_round]
display = Fountain (Round)
model = fountain_round
texture = marble_pillar
solid = 1
category = architecture
facing_arrow = 0

; Authored wall-backed like the banner: its back face is at the wall and the
; basin reaches into the room, so it hangs on a FACE and leaves the floor clear.
[fountain_wall]
display = Fountain (Wall)
model = fountain_wall
texture = marble_pillar
category = architecture
mount = wall

[fountain]
display = Fountain
model = fountain
texture = wall_stone
solid = 1
authored = 0
category = architecture
facing_arrow = 0

[statue]
display = Statue
model = statue
texture = wall_stone
solid = 1
authored = 0
category = statue

[wood_door]
display = Wooden Door (prop)
model = door
texture = wood_planks
solid = 1
authored = 0
category = gate
; A door PROP is a wall-plane object (0.28 deep), so it hangs on a face rather
; than standing mid-cell — a sealed/false door. A door you can actually open is
; the functional entity in doors.cat, not this.
mount = wall

[barrel]
display = Barrel
model = barrel
texture = wood_planks
solid = 1
authored = 0
category = container
facing_arrow = 0

