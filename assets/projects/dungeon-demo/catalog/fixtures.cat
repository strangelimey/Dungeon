; Fixtures: sconces and braziers (model + texture + mount).
; flame_height / flame_out are UNITS (1.0 = one dungeon square), like every
; model on disk — they name a point ON the mesh, so they scale with it.
; flame_scale is a dimensionless particle-effect size (brazier 1.0, sconce ~0.55).

[sconce]
display = Wall Sconce
category = light
model = wall_torch
texture = wall_torch
mount = wall
flame_height = 0.68
flame_scale = 0.55
flame_out = 0.064
; A torch in an iron bracket: knock it off the wall and the room goes dark. Cheap
; to break, and it does not care about fire — it is already alight (`fire 1.0` is
; immunity). NOT every fixture opts in: [brazier_empty] below authors none of this
; and cannot be touched, the same way most doors cannot.
destructible = 1
hp = 6
resists = fire 1.0, bash -0.4

[brazier]
display = Brazier
category = light
model = brazier_bowl
texture = brazier_bowl
part2_model = brazier_coals
part2_texture = brazier_coals
mount = floor
flame_height = 0.296
flame_scale = 1.0
; Cast iron on three legs: far tougher than a bracket, and it takes a real blow to
; tip over — but tipping it over is what douses it.
destructible = 1
hp = 30
armor = 4
resists = fire 1.0, slash 0.6, bash -0.2

[brazier_empty]
display = Empty Brazier
category = light
model = brazier_empty
texture = brazier_empty
mount = floor
flame = 0
