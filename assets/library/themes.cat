; The themes the library's styles name (one floor / wall / ceiling each, as in a world's themes.cat). Copied into a world with the style that names them.

[crypt_chamber]
display = Crypt Chamber
floor = floor_ancient_stone
wall = wall_stone_30
ceiling = ceiling_stone

[crypt_passage]
display = Crypt Passage
floor = floor_slabs
wall = wall_stone_28
ceiling = ceiling_cracked

[dirt_cave]
