floor = ground_soil_rocky
wall = wall_rock
ceiling = ceiling_rock_porous

[dirt_tunnel]
display = Dirt Tunnel
floor = ground_soil_dusty
wall = wall_rock
ceiling = ceiling_rock_layered

[barracks_room]
display = Barracks Room
floor = floor_stone_pavement
wall = wall_brick_old
ceiling = ceiling_rough

[barracks_hall]
display = Barracks Hall
floor = floor_cobble_medieval
wall = wall_brick_weathered
ceiling = ceiling_rough

[marble_hall]
display = Marble Hall
floor = floor_slabs
wall = wall_marble
ceiling = ceiling_stone

[marble_gallery]
